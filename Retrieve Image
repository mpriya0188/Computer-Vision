import cv2

# Read the image
image = cv2.imread("C:\Users\PRIYANKA M\OneDrive\Pictures\OIP.jpg")

# Check if the image is loaded
if image is None:
    print("Image not found!")
else:
    # Display the image
    cv2.imshow("Image", image)

    # Wait until a key is pressed
    cv2.waitKey(0)

    # Close all windows
    cv2.destroyAllWindows()
